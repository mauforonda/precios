{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "ketal",
  "title": "Ketal: productos y precios diarios",
  "description": "Catálogo de productos y precios diarios de Ketal (supermercado). Un archivo por mes (AAAA_MM.csv), de 2021-11-15 a 2022-10-31. La tienda dejó de publicar precios. Es una serie histórica cerrada, con un esquema distinto al de las demás tiendas (columnas en inglés). Cobertura al día (fechas, días sin datos, productos): cobertura.json en la raíz del repositorio.",
  "homepage": "https://github.com/mauforonda/precios",
  "keywords": [
    "precios",
    "Bolivia",
    "inflación",
    "supermercados",
    "histórico"
  ],
  "sources": [
    {
      "title": "Ketal",
      "path": "https://www.ketal.com.bo"
    }
  ],
  "resources": [
    {
      "name": "productos",
      "path": "productos.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "Catálogo de productos.",
      "schema": {
        "fields": [
          {
            "name": "id",
            "type": "integer",
            "description": "Código del producto.",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "category",
            "type": "string",
            "description": "Categoría."
          },
          {
            "name": "brand",
            "type": "string",
            "description": "Marca."
          },
          {
            "name": "name",
            "type": "string",
            "description": "Nombre del producto."
          }
        ],
        "primaryKey": [
          "id"
        ]
      }
    },
    {
      "name": "precios",
      "path": "20*.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "Precios diarios, un archivo por mes. 5 días sin datos en el período. Un producto tiene precio 0 en 199 filas. La clave (time, id) no se repite.",
      "schema": {
        "fields": [
          {
            "name": "time",
            "type": "date",
            "description": "Día del precio.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "id",
            "type": "integer",
            "description": "Código del producto. Une con productos.csv.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "price",
            "type": "number",
            "description": "Precio de venta en bolivianos (BOB). El valor 0 significa sin precio.",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "quantity",
            "type": "integer",
            "description": "Cantidad que reporta la fuente. Tiene muchos ceros y el valor 9999 en unas 48 mil filas. No usar como stock sin revisarla."
          }
        ],
        "primaryKey": [
          "time",
          "id"
        ],
        "foreignKeys": [
          {
            "fields": "id",
            "reference": {
              "resource": "productos",
              "fields": "id"
            }
          }
        ]
      }
    }
  ]
}
